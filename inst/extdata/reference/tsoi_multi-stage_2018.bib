
@article{tsoi_multi-stage_2018,
	title = {Multi-stage {Differentiation} {Defines} {Melanoma} {Subtypes} with {Differential} {Vulnerability} to {Drug}-{Induced} {Iron}-{Dependent} {Oxidative} {Stress}},
	volume = {33},
	issn = {1535-6108},
	url = {https://doi.org/10.1016/j.ccell.2018.03.017},
	doi = {10.1016/j.ccell.2018.03.017},
	abstract = {Malignant transformation can result in melanoma cells that resemble different stages of their embryonic development. Our gene expression analysis of human melanoma cell lines and patient tumors revealed that melanoma follows a two-dimensional differentiation trajectory that can be subclassified into four progressive subtypes. This differentiation model is associated with subtype-specific sensitivity to iron-dependent oxidative stress and cell death known as ferroptosis. Receptor tyrosine kinase-mediated resistance to mitogen-activated protein kinase targeted therapies and activation of the inflammatory signaling associated with immune therapy involves transitions along this differentiation trajectory, which lead to increased sensitivity to ferroptosis. Therefore, ferroptosis-inducing drugs present an orthogonal therapeutic approach to target the differentiation plasticity of melanoma cells to increase the efficacy of targeted and immune therapies.},
	number = {5},
	urldate = {2026-09-23},
	journal = {Cancer Cell},
	publisher = {Elsevier},
	author = {Tsoi, Jennifer and Robert, Lidia and Paraiso, Kim and Galvan, Carlos and Sheu, Katherine M. and Lay, Johnson and Wong, Deborah J.L. and Atefi, Mohammad and Shirazi, Roksana and Wang, Xiaoyan and Braas, Daniel and Grasso, Catherine S. and Palaskas, Nicolaos and Ribas, Antoni and Graeber, Thomas G.},
	month = may,
	year = {2018},
	pages = {890--904.e5},
	annote = {doi: 10.1016/j.ccell.2018.03.017},
}
